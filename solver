# 2. Frames and kinematics
# ----------------------------------------------------------------------------
def rotate(v, axis, angle_deg):
    """Rotate v by angle_deg about the unit axis k, where k is perpendicular to v.

    With k.v = 0 the rotation stays in the plane spanned by v and k x v, so
    v' = v cos a + (k x v) sin a, right-hand sense about k (plane rotation;
    Riley, Hobson & Bence, Mathematical Methods for Physics and Engineering,
    3rd ed., vector algebra).  Every call here meets the condition: pitch turns
    forward and up about starboard, roll turns starboard and up about forward.
    """
    assert abs(axis @ v) < 1e-9, "rotate() needs an axis perpendicular to the vector"
    a = math.radians(angle_deg)
    return v * math.cos(a) + np.cross(axis, v) * math.sin(a)


def body_axes(heading_deg, pitch_att_deg=0.0, roll_deg=0.0):
    """Forward / starboard / up unit vectors in ENU.

    Heading h clockwise from grid north: forward = (sin h, cos h, 0); starboard is
    forward rotated 90 deg clockwise.  Optional nose-up pitch (about starboard)
    then right-wing-down roll (about forward), yaw-pitch-roll order.
    Senses, with rotate()'s right-hand rule in ENU: starboard x forward = up,
    so a positive turn about starboard lifts the nose; forward x starboard =
    down, so a positive turn about forward drops the starboard side.  Both
    are checked below, so the sign cannot slip again (v4.8 and earlier
    turned the nose DOWN for a positive --pitch-att).
    """
    h = math.radians(heading_deg)
    fwd = np.array([math.sin(h), math.cos(h), 0.0])
    stbd = np.array([math.cos(h), -math.sin(h), 0.0])
    up = np.array([0.0, 0.0, 1.0])
    if pitch_att_deg:
        fwd, up = rotate(fwd, stbd, pitch_att_deg), rotate(up, stbd, pitch_att_deg)
        assert (fwd[2] > 0) == (pitch_att_deg > 0), "positive --pitch-att must raise the nose"
    if roll_deg:
        stbd, up = rotate(stbd, fwd, roll_deg), rotate(up, fwd, roll_deg)
        assert (stbd[2] < 0) == (roll_deg > 0), "positive --roll must lower the starboard side"
    return fwd, stbd, up


def wind_vector(wind_kt, wind_from_deg):
    """Velocity of the air (ENU, m/s).  Meteorological convention: the wind blows FROM wind_from_deg."""
    w = math.radians(wind_from_deg)
    return -wind_kt * KT * np.array([math.sin(w), math.cos(w), 0.0])


def blade_axes(az, pitch, fwd, stbd, up, rotor_dir):
    """Return (radial_out, motion, span, chord, normal) unit vectors; az and pitch in degrees.

    Works on scalars or broadcastable arrays (the result gains a trailing
    axis of length 3).  For rotation sign s (+1 clockwise from above) the
    direction of motion at azimuth theta is s (cos th stbd - sin th fwd).
    The leading edge faces the motion, so chord (LE -> TE) = -motion; pitch
    rotates chord and normal about the span axis (a 2-D rotation matrix).
    """
    th = np.radians(np.asarray(az, float))[..., None]
    b = np.radians(np.asarray(pitch, float))[..., None]
    radial = np.sin(th) * stbd + np.cos(th) * fwd
    motion = rotor_dir * (np.cos(th) * stbd - np.sin(th) * fwd)
    chord0 = -motion
    chord = np.cos(b) * chord0 - np.sin(b) * up
    normal = np.sin(b) * chord0 + np.cos(b) * up
    return radial, motion, -radial, chord, normal


def build_cfg(a, gun_alt=None, helo_alt=None, pitch_att=None, roll=None, cd=0.0,
              airspeed_kt=None, wind_kt=None, v0=None):
    """Everything the geometry and trajectory need, for one set of inputs."""
    gun_alt = a.gun_alt if gun_alt is None else gun_alt
    helo_alt = a.helo_alt if helo_alt is None else helo_alt
    pa = a.pitch_att if pitch_att is None else pitch_att
    ro = a.roll if roll is None else roll
    airspeed_kt = a.speed_kt if airspeed_kt is None else airspeed_kt
    wind_kt = a.wind_kt if wind_kt is None else wind_kt
    fwd, stbd, up = body_axes(a.heading, pa, ro)
    h = math.radians(a.heading)
    level_fwd = np.array([math.sin(h), math.cos(h), 0.0])
    wind = wind_vector(wind_kt, a.wind_from_deg)
    # Ground velocity = air velocity (airspeed along the heading) + wind; descent added separately
    v_helo = airspeed_kt * KT * level_fwd + wind + np.array([0.0, 0.0, -a.descent])
    sense = 1.0 if a.rotor_dir == "cw" else -1.0
    if a.rotor == "aft":
        hub = -0.5 * a.hub_sep_in * IN * fwd + a.aft_hub_up * up + np.array([0.0, 0.0, helo_alt])
        rotor_dir = sense
    else:
        hub = 0.5 * a.hub_sep_in * IN * fwd + a.fwd_hub_up * up + np.array([0.0, 0.0, helo_alt])
        rotor_dir = -sense                                   # tandem rotors turn in opposite senses
    return dict(axes=(fwd, stbd, up), v_helo=v_helo, wind=wind, hub=hub, helo_alt=helo_alt,
                omega=2.0 * math.pi * a.rpm / 60.0,          # omega = 2 pi N / 60
                r=(a.radius_ft * 12.0 - a.strike_from_tip_in) * IN,
                gun=np.array([a.gun_e - a.helo_e, a.gun_n - a.helo_n, gun_alt]),
                v0=a.v0 if v0 is None else v0, cd=cd, mass=a.proj_mass, dia=a.proj_dia,
                rho=a.air_density, reading=a.angle_reading, rotor_dir=rotor_dir)


def strike_target(cfg, az):
    return cfg["hub"] + cfg["r"] * blade_axes(az, 0.0, *cfg["axes"], cfg["rotor_dir"])[0]


# ----------------------------------------------------------------------------
# 3. Projectile
# ----------------------------------------------------------------------------
def vacuum_arrival(gun, target, v0):
    """Drag-free arrival, closed form.

    Trajectory y = x tan a - g x^2 / (2 v0^2 cos^2 a) (McCoy, Modern Exterior
    Ballistics, ch. 3); with 1/cos^2 = 1 + tan^2 this is a quadratic
    in tan a, low root = direct fire.  Flight time t = x / (v0 cos a),
    vertical velocity v0 sin a - g t.  Wind has no effect without drag.
    """
    d = target - gun
    dh = math.hypot(d[0], d[1])
    k = G * dh ** 2 / (2.0 * v0 ** 2)
    disc = dh ** 2 - 4.0 * k * (k + d[2])
    if disc < 0:
        return None
    a = math.atan((dh - math.sqrt(disc)) / (2.0 * k))
    t = dh / (v0 * math.cos(a))
    u = d[:2] / dh
    vp = np.array([v0 * math.cos(a) * u[0], v0 * math.cos(a) * u[1], v0 * math.sin(a) - G * t])
    return dict(vp=vp, el=math.degrees(a), t=t, aim=math.degrees(math.atan2(u[0], u[1])) % 360.0)


def fly(gun, target, v0, cd, mass, dia, rho, wind, dt=2e-3, tol=1e-7):
    """Point-mass trajectories with quadratic drag relative to the air, one row per sample.

    m dv/dt = -1/2 rho Cd A |v - w| (v - w) + m g   (McCoy, Modern Exterior
    Ballistics, ch. 5), integrated with classical fourth-order Runge-Kutta
    (Riley, Hobson & Bence, 3rd ed., ch. 27, p. 1026).
    Hitting the target is a two-point boundary-value problem solved by
    shooting: guess the launch elevation, march the trajectory out to the
    target's range, and iterate on the starting value until the height there
    matches (Riley, Hobson & Bence, 3rd ed., p. 1030).
    The launch elevation is found by the secant method (RHB's "linear
    interpolation", p. 988) on the height error at
    the target's horizontal range, and the launch azimuth is aimed off for
    wind drift by removing the lateral miss.  Returns arrival velocity (n,3),
    launch elevation (deg), flight time (s) and launch azimuth (deg, grid);
    rows that cannot reach the target are NaN.
    """
    gun = np.atleast_2d(gun); target = np.atleast_2d(target)
    n = len(target)
    d = target - gun
    dh = np.hypot(d[:, 0], d[:, 1])
    u = d[:, :2] / dh[:, None]
    rgt = np.column_stack([u[:, 1], -u[:, 0]])
    v0 = np.broadcast_to(np.asarray(v0, float), (n,))
    k = np.broadcast_to(0.5 * rho * np.asarray(cd, float) * math.pi * (dia / 2) ** 2 / mass, (n,))
    w = np.broadcast_to(np.asarray(wind, float), (n, 3))

    def acc(v):
        rel = v - w
        s = np.linalg.norm(rel, axis=1)
        out = -k[:, None] * s[:, None] * rel
        out[:, 2] -= G
        return out

    def shoot(el, dpsi):
        hdir = np.cos(dpsi)[:, None] * u + np.sin(dpsi)[:, None] * rgt
        vel = np.zeros((n, 3)); pos = np.zeros((n, 3))
        vel[:, :2] = (v0 * np.cos(el))[:, None] * hdir
        vel[:, 2] = v0 * np.sin(el)
        z_at = np.full(n, np.nan); y_at = np.full(n, np.nan); t_at = np.full(n, np.nan)
        v_at = np.full((n, 3), np.nan)
        done = np.zeros(n, bool); t = 0.0
        while not done.all() and t < 10.0:
            k1 = acc(vel); v2 = vel + 0.5 * dt * k1
            k2 = acc(v2);  v3 = vel + 0.5 * dt * k2
            k3 = acc(v3);  v4 = vel + dt * k3
            k4 = acc(v4)
            vel_n = vel + dt / 6.0 * (k1 + 2 * k2 + 2 * k3 + k4)
            pos_n = pos + dt / 6.0 * (vel + 2 * v2 + 2 * v3 + v4)
            p_old = pos[:, 0] * u[:, 0] + pos[:, 1] * u[:, 1]
            p_new = pos_n[:, 0] * u[:, 0] + pos_n[:, 1] * u[:, 1]
            hit = (~done) & (p_new >= dh)
            if hit.any():
                f = (dh[hit] - p_old[hit]) / (p_new[hit] - p_old[hit])      # linear interpolation within a step
                P0, P1 = pos[hit], pos_n[hit]
                z_at[hit] = P0[:, 2] + f * (P1[:, 2] - P0[:, 2])
                y_at[hit] = (P0[:, 0] + f * (P1[:, 0] - P0[:, 0])) * rgt[hit, 0] + (P0[:, 1] + f * (P1[:, 1] - P0[:, 1])) * rgt[hit, 1]
                v_at[hit] = vel[hit] + f[:, None] * (vel_n[hit] - vel[hit])
                t_at[hit] = t + f * dt
                done |= hit
            pos, vel = pos_n, vel_n; t += dt
        return z_at - d[:, 2], y_at, v_at, t_at

    with np.errstate(invalid="ignore", divide="ignore"):
        dpsi = np.zeros(n)
        el0 = np.arctan2(d[:, 2], dh) + math.radians(2.0)
        el1 = el0 + math.radians(1.5)
        f0, y0, _, _ = shoot(el0, dpsi)
        dpsi = dpsi - np.nan_to_num(y0) / dh
        f1, y1, v, t = shoot(el1, dpsi)
        for _ in range(30):
            dpsi = dpsi - np.nan_to_num(y1) / dh
            den = f1 - f0
            el2 = np.where(np.abs(den) > 1e-14, el1 - f1 * (el1 - el0) / den, el1)
            el0, f0, el1 = el1, f1, el2
            f1, y1, v, t = shoot(el1, dpsi)
            if np.nanmax(np.abs(f1), initial=0) < tol and np.nanmax(np.abs(y1), initial=0) < tol:
                break
    aim = (np.degrees(np.arctan2(u[:, 0], u[:, 1]) + dpsi)) % 360.0
    bad = ~np.isfinite(f1) | (np.abs(f1) > 1e-3)
    v[bad] = np.nan
    return v, np.degrees(el1), t, aim


def arrival(cfg, target):
    """Arrival of the round at `target` for this configuration (vacuum closed form when Cd = 0)."""
    if cfg["cd"] == 0.0:
        return vacuum_arrival(cfg["gun"], target, cfg["v0"])
    v, el, t, aim = fly(cfg["gun"], target, cfg["v0"], cfg["cd"], cfg["mass"], cfg["dia"], cfg["rho"], cfg["wind"])
    if not np.isfinite(v[0]).all():
        return None
    return dict(vp=v[0], el=float(el[0]), t=float(t[0]), aim=float(aim[0]))


# ----------------------------------------------------------------------------
# 4. Strike geometry and the blade solver
# ----------------------------------------------------------------------------
def angle_fields(az, pitch, vp, cfg):
    """The two JCAT-style angles for blade azimuth(s) az and pitch(es), degrees.

    Relative velocity v_rel = v_projectile - v_blade (Galilean addition), with
    v_blade = v_helicopter + omega r (direction of motion) (rigid rotation).
    Projected reading (default): planform = atan2(v_chord, v_span), the path
    against the leading edge seen on the blade's plan; section =
    atan2(v_normal, v_chord), the path against the bottom surface seen in
    cross-section.  JCAT slide 28 draws the angles this way.  true3d reading:
    angle to the leading edge acos(v_span/|v|) and to the chord plane
    asin(v_normal/|v|).
    """
    fwd, stbd, up = cfg["axes"]
    radial, motion, span, chord, normal = blade_axes(az, pitch, fwd, stbd, up, cfg["rotor_dir"])
    vrel = vp - (cfg["v_helo"] + cfg["omega"] * cfg["r"] * motion)
    vs = (vrel * span).sum(-1); vc = (vrel * chord).sum(-1); vn = (vrel * normal).sum(-1)
    if cfg["reading"] == "projected":
        a1, a2 = np.degrees(np.arctan2(vc, vs)), np.degrees(np.arctan2(vn, vc))
    else:
        nv = np.linalg.norm(vrel, axis=-1)
        a1, a2 = np.degrees(np.arccos(np.clip(vs / nv, -1, 1))), np.degrees(np.arcsin(np.clip(vn / nv, -1, 1)))
    a1, a2 = np.broadcast_arrays(a1, a2)          # the span component depends on azimuth only
    return a1, a2, (vs, vc, vn, vrel)


def _wrap(x):
    return (x + 180.0) % 360.0 - 180.0


K_EXACT = 12       # exact trajectories per case, 30 deg apart round the rotor circle
H_FIT = 4          # Fourier harmonics fitted through them (fit error ~2e-6 deg, the integrator's own noise)
GRID = 0.05        # deg: the fit is scanned for solutions at this azimuth step
POLISH_TOL = 1e-8  # deg: exact polish stops when a step moves the azimuth less than this


def _basis(az):
    """Fourier basis 1, cos(h az), sin(h az) for h = 1..H_FIT, one row per azimuth (deg).

    A truncated Fourier series in azimuth (Riley, Hobson & Bence, 3rd ed.,
    ch. 12, pp. 415-432).  Used only to locate solutions: see find_roots.
    """
    th = np.radians(np.atleast_1d(np.asarray(az, float)))[:, None]
    cols = [np.ones_like(th)]
    for h in range(1, H_FIT + 1):
        cols += [np.cos(h * th), np.sin(h * th)]
    return np.hstack(cols)


def _arrivals(cfgs, idx, az):
    """Exact arrival velocity (n, 3) at the strike point of blade azimuth az[k] in case cfgs[idx[k]].

    Drag-free cases use the closed form; the rest are flown together in one
    vectorised call.  Rows the round cannot reach are NaN.
    """
    idx = np.atleast_1d(np.asarray(idx)); az = np.atleast_1d(np.asarray(az, float))
    tg = np.array([strike_target(cfgs[i], z) for i, z in zip(idx, az)]).reshape(-1, 3)
    out = np.full((len(idx), 3), np.nan)
    vac = np.array([cfgs[i]["cd"] == 0.0 for i in idx], bool)
    for k in np.where(vac)[0]:
        r = vacuum_arrival(cfgs[idx[k]]["gun"], tg[k], cfgs[idx[k]]["v0"])
        if r is not None:
            out[k] = r["vp"]
    dr = np.where(~vac)[0]
    if len(dr):
        c0 = cfgs[idx[dr[0]]]                  # mass, calibre and air density are the same in every case
        v, _, _, _ = fly(np.array([cfgs[i]["gun"] for i in idx[dr]]), tg[dr],
                         np.array([cfgs[i]["v0"] for i in idx[dr]]), np.array([cfgs[i]["cd"] for i in idx[dr]]),
                         c0["mass"], c0["dia"], c0["rho"], np.array([cfgs[i]["wind"] for i in idx[dr]]))
        out[dr] = v
    return out


def _residual(cfg, az, vp, P, S):
    """Planform error (deg) at blade azimuth(s) az, with the blade pitch in closed form.

    Feathering by pitch b turns the chord and normal about the span, a rotation
    in a plane, so the relative velocity's chord and normal components are its
    components (A, B) along the unpitched chord and the disc normal turned
    through b:  v_chord = rho cos(phi + b),  v_normal = rho sin(phi + b), with
    rho = sqrt(A^2 + B^2) and phi = atan2(B, A).
    Projected reading: the section angle atan2(v_normal, v_chord) is phi + b,
    so the pitch that gives section angle S is b = S - phi, and then
    v_chord = rho cos S: the planform error depends on azimuth alone.
    True-3-D reading: the angle to the leading edge, acos(v_span / |v|), does
    not depend on pitch, and asin(v_normal / |v|) = S has two pitch branches.
    Returns the error (n,) and the pitch (n, 2); the second column is used by
    the true-3-D reading only.
    """
    az = np.atleast_1d(np.asarray(az, float))
    _, motion, span, chord0, normal0 = blade_axes(az, 0.0, *cfg["axes"], cfg["rotor_dir"])
    vrel = vp - (cfg["v_helo"] + cfg["omega"] * cfg["r"] * motion)
    A = (vrel * chord0).sum(-1); B = (vrel * normal0).sum(-1); vs = (vrel * span).sum(-1)
    phi = np.degrees(np.arctan2(B, A)); rho = np.hypot(A, B)
    pitch = np.full((len(az), 2), np.nan)
    with np.errstate(invalid="ignore", divide="ignore"):
        if cfg["reading"] == "projected":
            err = _wrap(np.degrees(np.arctan2(rho * math.cos(math.radians(S)), vs)) - P)
            pitch[:, 0] = _wrap(S - phi)
        else:
            nv = np.linalg.norm(vrel, axis=-1)
            err = np.degrees(np.arccos(np.clip(vs / nv, -1.0, 1.0))) - P
            s = nv * math.sin(math.radians(S)) / rho
            asn = np.degrees(np.arcsin(np.clip(s, -1.0, 1.0)))
            fits = np.abs(s) <= 1.0
            pitch[:, 0] = np.where(fits, _wrap(asn - phi), np.nan)
            pitch[:, 1] = np.where(fits, _wrap(180.0 - asn - phi), np.nan)
    return err, pitch


def find_roots(cfgs, P, S, top_only=False):
    """Every blade orientation that reproduces the two angles, for one case or many.

    No starting guess.  For each case:
    1. Fly K_EXACT exact trajectories to strike points 30 deg apart round the
       rotor circle and fit a Fourier series in azimuth (RHB ch. 12,
       pp. 415-432) by least squares (RHB p. 1271) through the arrival
       velocities.  The arrival changes smoothly as the strike point moves round
       the 6 m circle, and the fit matches exact trajectories to about 2e-6 deg.
    2. Scan the fit every GRID deg for sign changes of the planform error, and
       look closer wherever the error turns back close to zero, because two
       solutions about to merge can sit between grid points.
    3. Polish each solution with exact trajectories: secant steps inside the
       bracket, halving it when a step would leave it (RHB sec. 27.1: linear
       interpolation, p. 988, and binary chopping).
    The fit only tells the solver where to look; every reported value comes from exact
    trajectories.  Pitches of 90 deg or more are dropped.  top_only keeps just
    the highest-pitch solution (the Monte Carlo).  Returns a list per case of
    (azimuth, pitch), highest pitch first, and the number of located solutions
    that exact trajectories could not confirm.
    """
    n = len(cfgs)
    P = np.broadcast_to(np.asarray(P, float), (n,)); S = np.broadcast_to(np.asarray(S, float), (n,))
    azK = np.arange(K_EXACT) * 360.0 / K_EXACT
    vK = _arrivals(cfgs, np.repeat(np.arange(n), K_EXACT), np.tile(azK, n)).reshape(n, K_EXACT, 3)
    grid = np.arange(0.0, 360.0, GRID); BK, BG = _basis(azK), _basis(grid)
    cand = []                                                     # (case, located root, bracket half-width)
    for i in range(n):
        cf, Pi, Si = cfgs[i], P[i], S[i]
        if np.isfinite(vK[i]).all():
            coef = np.linalg.lstsq(BK, vK[i], rcond=None)[0]     # least squares, 12 points, 9 coefficients (RHB p. 1271)
            model = lambda z, coef=coef: _basis(z) @ coef
            vg = BG @ coef
        else:                   # part of the circle is out of reach: exact arrivals every 0.5 deg instead of the fit
            a5 = np.arange(0.0, 360.0, 0.5); v5 = _arrivals(cfgs, np.full(len(a5), i), a5)
            model = lambda z, a5=a5, v5=v5: np.column_stack(
                [np.interp(np.atleast_1d(z), a5, v5[:, j], period=360.0) for j in range(3)])
            vg = model(grid)
        err, _ = _residual(cf, grid, vg, Pi, Si)
        e2 = np.append(err, err[0]); a2 = np.append(grid, 360.0)
        good = np.isfinite(e2) & (np.abs(e2) < 90.0)
        brackets = [(a2[k], a2[k + 1]) for k in
                    np.where(good[:-1] & good[1:] & (np.sign(e2[:-1]) != np.sign(e2[1:])))[0]]
        m = len(err)
        for k in np.where(good[:m] & (np.abs(err) < 0.2))[0]:   # error turns back near zero: look closer
            b4, af = err[k - 1], err[(k + 1) % m]
            if (err[k] - b4) * (af - err[k]) < 0 and np.sign(b4) == np.sign(err[k]) == np.sign(af):
                fine = np.linspace(grid[k] - GRID, grid[k] + GRID, 201)
                ef, _ = _residual(cf, fine, model(fine), Pi, Si)
                brackets += [(fine[j], fine[j + 1]) for j in np.where(np.sign(ef[:-1]) != np.sign(ef[1:]))[0]]
        located = []
        for lo, hi in brackets:
            ev, pv = _residual(cf, [lo, hi], model(np.array([lo, hi])), Pi, Si)
            f = ev[0] / (ev[0] - ev[1])
            p = pv[0] + f * (pv[1] - pv[0])
            p = p[np.abs(p) < 91.0]
            if len(p):
                located.append(((lo + f * (hi - lo)) % 360.0, p.max()))
        located.sort()
        if top_only and located:
            best = max(p for _, p in located)
            keep = [x for x in located if x[1] >= best - 1.0]
        else:
            keep = located
        for r, _ in keep:
            gaps = [abs(_wrap(r - q)) for q, _ in located if abs(_wrap(r - q)) > 0.0]
            w = min([0.01] + [0.45 * g for g in gaps])
            cand.append((i, r, w))

    out = [[] for _ in range(n)]
    if not cand:
        return out, 0
    ci = np.array([c[0] for c in cand]); r = np.array([c[1] for c in cand]); w = np.array([c[2] for c in cand])

    def exact(k, z):                                               # error and pitch from exact trajectories
        vp = _arrivals(cfgs, ci[k], z)
        e = np.full(len(k), np.nan); p = np.full((len(k), 2), np.nan)
        for j, kk in enumerate(k):
            ee, pp = _residual(cfgs[ci[kk]], z[j:j + 1], vp[j:j + 1], P[ci[kk]], S[ci[kk]])
            e[j], p[j] = ee[0], pp[0]
        return e, p

    allk = np.arange(len(cand))
    lo, hi = r - w, r + w
    flo, _ = exact(allk, lo); fhi, _ = exact(allk, hi)
    bracketed = np.isfinite(flo) & np.isfinite(fhi) & (np.sign(flo) != np.sign(fhi))
    x0, f0, x1, f1 = lo.copy(), flo.copy(), hi.copy(), fhi.copy()
    root = np.full(len(cand), np.nan); pitch = np.full((len(cand), 2), np.nan)
    active = bracketed.copy()
    for _ in range(40):
        k = np.where(active)[0]
        if not len(k):
            break
        with np.errstate(invalid="ignore", divide="ignore"):
            x = x1[k] - f1[k] * (x1[k] - x0[k]) / (f1[k] - f0[k])      # secant step
        x = np.where(np.isfinite(x) & (lo[k] < x) & (x < hi[k]), x, 0.5 * (lo[k] + hi[k]))   # else halve
        fx, px = exact(k, x)
        same = np.sign(fx) == np.sign(flo[k])
        lo[k] = np.where(same, x, lo[k]); flo[k] = np.where(same, fx, flo[k])
        hi[k] = np.where(same, hi[k], x); fhi[k] = np.where(same, fhi[k], fx)
        step = np.abs(x - x1[k])
        x0[k], f0[k] = x1[k], f1[k]
        x1[k], f1[k] = x, fx
        root[k], pitch[k] = x, px
        active[k[(step < POLISH_TOL) | (fx == 0.0) | (hi[k] - lo[k] < POLISH_TOL)]] = False
    for kk in np.where(bracketed)[0]:
        for p in pitch[kk]:
            if np.isfinite(p) and abs(p) < 90.0:
                az = root[kk] % 360.0
                if not any(abs(_wrap(az - q)) < 1e-6 and abs(p - pp) < 1e-6 for q, pp in out[ci[kk]]):
                    out[ci[kk]].append((az, p))
    for i in range(n):
        out[i].sort(key=lambda x: -x[1])
        if top_only:
            out[i] = out[i][:1]
    return out, int((~bracketed).sum())


def solve_strike(cfg, P, S):
    """Blade azimuth and pitch for one case: the highest-pitch solution, with every solution in 'roots'."""
    roots, unresolved = find_roots([cfg], P, S)
    roots = roots[0]
    if not roots:
        return None
    az, pitch = roots[0]
    arr = arrival(cfg, strike_target(cfg, az))
    if arr is None:
        return None
    return dict(az=az, pitch=pitch, roots=roots, unresolved=unresolved, target=strike_target(cfg, az), **arr)


