def direction(p):
    """Grid bearing (deg) and elevation (deg) of vector p, elevation on horizontal range."""
    return (math.degrees(math.atan2(p[0], p[1])) % 360.0,
            math.degrees(math.atan2(p[2], math.hypot(p[0], p[1]))))


def report(a):
    P, S = a.planform_angle, a.section_angle
    cd_mid = 0.5 * (a.cd_min + a.cd_max)
    cfg = build_cfg(a, cd=0.0 if a.vacuum else cd_mid)
    case = "vacuum, drag-free" if a.vacuum else f"drag, Cd {cd_mid:.3f}"     # the case printed in full
    gv = cfg["v_helo"][:2]
    track = math.degrees(math.atan2(gv[0], gv[1])) % 360.0
    g2t = a.grid_to_true_deg
    print("Extortion 17 aft-rotor blade-strike geometry, v4.13\n" + "=" * 52)
    print("INPUTS")
    print("For the following known values:")
    helo, gun = location_lines(a)
    print("\n".join(helo))
    ind = "              "                                                    # indented under the helicopter
    print(f"{ind}Airspeed {a.speed_kt:.1f} kt on {a.heading:.2f} grid ({(a.heading + g2t) % 360:.2f} T);")
    print(f"{ind}wind {a.wind_kt:.1f} kt from {a.wind_from_deg:.0f} T;")
    print(f"{ind}Descent {a.descent} m/s")
    print(f"{ind}Ground speed {np.linalg.norm(gv) / KT:.1f} kt on track {track:.1f} grid"
          f" ({(track + g2t) % 360:.1f} T) (crab {_wrap(track - a.heading):+.1f})")
    print(f"{ind}Blade element speed round hub: {cfg['omega'] * cfg['r']:.1f} m/s @ r = {cfg['r']:.3f}m")
    print("\n".join(gun))
    print(f"{ind}Offset from helo centre (grid E, N): ({cfg['gun'][0]:.0f}, {cfg['gun'][1]:.0f}) m")
    gb = math.degrees(math.atan2(cfg["gun"][0], cfg["gun"][1])) % 360.0      # where the round came FROM
    rel = _wrap(gb - a.heading)
    print(f"{ind}Azimuth {gb:.1f} grid ({(gb + a.grid_to_true_deg) % 360:.1f} true) from helo centre,")
    print(f"{ind}= bearing {abs(rel):.1f} deg {'starboard' if rel >= 0 else 'port'} of the nose")
    preset = ROUNDS[a.round]
    entered = (a.v0, a.proj_mass, a.proj_dia) != (preset["v0"], preset["mass"], preset["dia"])
    print(f"Round {a.round}: fires the {a.projectile} grenade, launch speed {a.v0:.0f} m/s,"
          f" {a.proj_mass:.3f} kg, {a.proj_dia * 1000:.0f} mm" + (" (as entered)" if entered else ""))
    print(f"Air density {a.air_density:.4f} kg/m^3 ({a.air_density_source})")
    print(f"Printed in full: {case}")
    if a.vacuum:
        print(f"{ind}(drag cases in the DRAG BRACKET below)\n")
    else:
        print(f"{ind}(middle of the BRL bracket, {a.cd_min:.2f}-{a.cd_max:.2f};")
        print(f"{ind} vacuum: DRAG BRACKET below, or ex17_vacuum_check.py)\n")
    src = ("JCAT slide 28" if a.angles_are_jcat else "as entered")
    if a.angle_reading == "projected":
        print(f"Find the blade bearing and pitch at which the projectile strikes the blade at {P:g} deg"
              f" to the leading edge (plan) and {S:g} deg to the lower surface (section) ({src}).\n")
    else:
        print(f"Find the blade bearing and pitch at which the projectile strikes the blade at {P:g} deg"
              f" to the leading edge (3-D) and {S:g} deg to the blade's chord plane (3-D) ({src}).\n")

    s = solve_strike(cfg, P, S)
    if s is None:
        print("No solution for these inputs.")
        return
    az, pitch = s["az"], s["pitch"]
    F1, F2, (vs, vc, vn, vrel) = angle_fields(az, pitch, s["vp"], cfg)
    v_b = cfg["v_helo"] + cfg["omega"] * cfg["r"] * blade_axes(az, pitch, *cfg["axes"], cfg["rotor_dir"])[1]
    d = s["target"] - cfg["gun"]; dh = math.hypot(d[0], d[1])
    los_el = math.degrees(math.atan2(d[2], dh))
    print(f"SOLUTION, IN FULL: {case}")
    print(f"Blade bearing: {az:.2f} deg starboard of the nose (clockwise)")
    print(f"                       = {(az + 180) % 360:.2f} deg standard rotor azimuth ")
    print("                        (from tail, with rotation)")
    print(f"                       ; blade span line azimuth {(a.heading + az) % 360:.1f} grid")
    print(f"                         ({(a.heading + az + g2t) % 360:.1f} true)")
    print(f"Blade pitch (surface): {pitch:.2f} deg leading-edge-up at the strike station")
    print(f"  Retreating blade     : {'yes' if (v_b @ cfg['axes'][0]) < 0 else 'no'}")
    for r in s["roots"][1:]:
        print(f"  Other solution       : bearing {r[0]:.2f} deg, pitch {r[1]:.2f} deg"
              + ("  (physically implausible blade pitch)" if abs(r[1]) > 45 else ""))
    if len(s["roots"]) > 1:
        print("  (each solution is computed with its own strike point and trajectory)")
    if s["unresolved"]:
        print(f"  ({s['unresolved']} further candidate(s) near a fold could not be confirmed with exact trajectories)")
    print(f"TRAJECTORY ({case})")
    print(f"  Strike point (grid)   : E {a.helo_e + s['target'][0]:.1f}, N {a.helo_n + s['target'][1]:.1f}, {s['target'][2]:.1f} m AMSL")
    print(f"                          MGRS {mgrs(a.helo_e + s['target'][0], a.helo_n + s['target'][1])} (1 m)")
    print(f"  Horizontal / vertical / slant: {dh:.2f} / {d[2]:.2f} / {np.linalg.norm(d):.2f} m")
    print(f"  Launch elevation {s['el']:.2f} deg; line of sight {los_el:.2f} deg; holdover {s['el'] - los_el:.2f} deg")
    print(f"  Launch azimuth (initial direction of projectile) {s['aim']:.2f} grid = {(s['aim'] + a.grid_to_true_deg) % 360:.2f} true;"
          f" flight time {s['t']:.3f} s")
    sa = math.degrees(math.atan2(d[0], d[1])) % 360.0                    # straight line, firing point to strike point
    print(f"  Launch to strike azimuth (firing point to strike point) {sa:.2f} grid = {(sa + a.grid_to_true_deg) % 360:.2f} true")
    print(f"  Drop below line of departure at the strike point: {dh * math.tan(math.radians(s['el'])) - d[2]:.2f} m")
    pb, pe = direction(s["vp"]); bb, be = direction(v_b)
    print(f"  Arrival: {np.linalg.norm(s['vp']):.1f} m/s, azimuth {pb:.1f} grid, elevation {pe:+.2f} deg")
    print(f"  Blade element: {np.linalg.norm(v_b):.1f} m/s, azimuth {bb:.1f} grid, elevation {be:+.2f} deg")
    print("RELATIVE VELOCITY IN BLADE AXES")
    print(f"  span (tip->root) {float(vs):.1f}, chord (LE->TE) {float(vc):.1f}, normal (bottom->top) {float(vn):.1f} m/s;"
          f" |v_rel| {np.linalg.norm(vrel):.1f} m/s")
    if a.angle_reading == "projected":
        print(f"  Projectile strikes rotor blade at {float(F1):.3f} deg to leading edge (plan), {float(F2):.3f} deg"
              f" to surface of the blade (section). Targets {P}, {S} ({src}).\n")
    else:
        print(f"  Projectile strikes rotor blade at {float(F1):.3f} deg to leading edge (3-D), {float(F2):.3f} deg"
              f" to the blade's chord plane (3-D). Targets {P}, {S} ({src}).\n")

    print(f"DRAG BRACKET (air density {a.air_density:.3f} kg/m^3)")
    spread = {"drag": [], "height": [], "angles": [(az, pitch)]}      # results kept for the summary at the end
    for cdv in (0.0, a.cd_min, cd_mid, a.cd_max):
        r = solve_strike(build_cfg(a, cd=cdv), P, S)
        spread["drag"].append(r and (r["az"], r["pitch"]))
        lab = "vacuum" if cdv == 0 else f"Cd {cdv:.3f}"
        if cdv == cfg["cd"]:
            lab += " *"                                              # the case printed in full above
        print(f"  {lab:10s}: " + (f"rotor blade bearing {r['az']:.2f}, pitch {r['pitch']:.2f};"
                                   f" projectile arrival {np.linalg.norm(r['vp']):.1f} m/s,"
                                   f" az {direction(r['vp'])[0]:.2f} deg grid, el {direction(r['vp'])[1]:+.2f} deg,"
                                   f" launch el {r['el']:.2f} deg, flight {r['t']:.3f} s"
                                   if r else "no solution"))
        if r:
            # Two directions from the firing point.  The launch azimuth (as in TRAJECTORY) is where the round
            # is sent: it carries any allowance for wind drift.  The launch to strike azimuth is the straight
            # line to the strike point (not the arrival azimuth, which is the projectile's direction there), the geometry the blade angles are worked from.  In calm air the trajectory
            # stays in one vertical plane and the two are the same; with wind they differ by the drift
            # allowance.  Both move round as drag moves the strike point.
            dt_ = r["target"] - cfg["gun"]
            sb = math.degrees(math.atan2(dt_[0], dt_[1])) % 360.0
            print(f"{ind}projectile launch azimuth {r['aim']:.2f} grid ({(r['aim'] + a.grid_to_true_deg) % 360:.2f} true)")
            print(f"{ind}launch to strike azimuth {sb:.2f} grid ({(sb + a.grid_to_true_deg) % 360:.2f} true)")
            print(f"{ind}horiz./vert./slant: {math.hypot(dt_[0], dt_[1]):.2f} / {dt_[2]:.2f} / {np.linalg.norm(dt_):.2f} m")
            print(f"{ind}strike point MGRS {mgrs(a.helo_e + r['target'][0], a.helo_n + r['target'][1])} (1 m)")
    print(f"{ind}* printed in full above")
    if a.wind_kt:
        print(f"{ind}(launch azimuths include the allowance for wind drift;")
        print(f"{ind} launch to strike azimuths are the straight line,")
        print(f"{ind} firing point to strike point)")
    print()

    print(f"SENSITIVITY: firing-point altitude +/- {a.gun_alt_tol:.0f} m ({case})")
    for dz in (-a.gun_alt_tol, 0.0, a.gun_alt_tol):
        r = solve_strike(build_cfg(a, gun_alt=a.gun_alt + dz, cd=cfg["cd"]), P, S)
        spread["height"].append(r and (r["az"], r["pitch"]))
        print(f"  {a.gun_alt + dz:7.1f} m AMSL -> " + (f"bearing {r['az']:.2f}, pitch {r['pitch']:.2f}" if r else "no solution"))
    print(f"SENSITIVITY: JCAT angles +/- {a.angle_tol:g} deg ({case};")
    print(f"{ind}the author's tolerance: JCAT gives none)")
    for dp, ds in ((-a.angle_tol, 0), (a.angle_tol, 0), (0, -a.angle_tol), (0, a.angle_tol)):
        r = solve_strike(cfg, P + dp, S + ds)
        spread["angles"].append(r and (r["az"], r["pitch"]))
        print(f"  planform {P + dp:5.1f}, section {S + ds:5.1f} -> " + (f"bearing {r['az']:.2f}, pitch {r['pitch']:.2f}" if r else "no solution"))
    if a.attitude_tol:
        # Opt-in: JCAT records the attitude as unknown, so there is no source tolerance to test against.
        # The range is the reader's choice (--attitude-tol); each axis is tilted on its own about the
        # case's own attitude (level by default), as in the validation document's attitude tables.
        spread["attitude"] = [(az, pitch)]
        print(f"SENSITIVITY: disc attitude +/- {a.attitude_tol:g} deg ({case};")
        print(f"{ind}illustrative range: JCAT records the attitude as unknown)")
        for key, lab, pos, neg in (("pitch_att", "pitch", "nose up", "nose down"),
                                   ("roll", "roll", "right wing down", "left wing down")):
            base_att = getattr(a, key)
            for sgn in (-1.0, 1.0):
                x = base_att + sgn * a.attitude_tol
                r = solve_strike(build_cfg(a, cd=cfg["cd"], **{key: x}), P, S)
                spread["attitude"].append(r and (r["az"], r["pitch"]))
                word = pos if x > 0 else (neg if x < 0 else "level")
                print(f"  {lab:5s} {abs(x):4.1f} {word:15s} -> " + (f"bearing {r['az']:.2f}, pitch {r['pitch']:.2f}" if r else "no solution"))
    what_moves_it(a, spread)


def what_moves_it(a, spread):
    """Say in words which of the checks above moves the answer most, from this run's own results.

    For each source (the author's tolerance on JCAT's angles, firing-point altitude,
    drag) the spread is the range, max minus min, of the blade bearing and of the pitch
    over the solves that found a solution.  Printed so that a reader, or a summary of the output, cannot mistake the
    small drag effect for the whole uncertainty.
    """
    labels = {"angles": f"JCAT angles +/- {a.angle_tol:g} deg +",
              "height": f"Firing-point altitude +/- {a.gun_alt_tol:g} m",
              "drag": f"Drag, Cd 0 to {a.cd_max:.2f}",
              "attitude": f"Disc attitude +/- {a.attitude_tol:g} deg *"}
    rows = {}
    print("WHAT MOVES THE ANSWER (spread across the checks above: blade bearing / pitch)")
    for key in [k for k in ("angles", "height", "drag", "attitude") if k in spread]:
        got = [x for x in spread[key] if x]
        missing = len(spread[key]) - len(got)
        note = f"; {missing} of {len(spread[key])} had no solution" if missing else ""
        if len(got) < 2:
            print(f"  {labels[key]:30s}: not enough solutions to measure{note}")
            continue
        azs, pis = [g[0] for g in got], [g[1] for g in got]
        rows[key] = (max(azs) - min(azs), max(pis) - min(pis))
        extra = (f"  (bearing {min(azs):.1f} to {max(azs):.1f}, pitch {min(pis):.1f} to {max(pis):.1f})"
                 if key == "angles" else "")
        print(f"  {labels[key]:30s}: {rows[key][0]:4.1f} / {rows[key][1]:4.1f} deg{extra}{note}")
    print("    + the author's tolerance, not JCAT's:")
    print("      JCAT gives the angles as approximate")
    if "attitude" in spread:
        print("    * illustrative range, not a source tolerance:")
        print("      JCAT records the attitude as unknown")
    else:
        print(f"  {'Disc attitude':30s}: not tested (JCAT: unknown);")
        print(f"  {'':30s}  try --attitude-tol 2.5")
    if rows:
        top_az = max(rows, key=lambda k: rows[k][0]); top_pi = max(rows, key=lambda k: rows[k][1])
        name = {"angles": "the author's tolerance on JCAT's angles", "height": "the firing-point altitude", "drag": "drag",
                "attitude": "the disc attitude (illustrative range)"}
        if top_az == top_pi:
            print(f"  -> {name[top_az][0].upper() + name[top_az][1:]} moves both blade bearing and pitch most."
                  " The Monte Carlo (--mc 200) combines them.")
        else:
            print(f"  -> {name[top_az][0].upper() + name[top_az][1:]} moves blade bearing most; {name[top_pi]} moves pitch most."
                  " The Monte Carlo (--mc 200) combines them.")


