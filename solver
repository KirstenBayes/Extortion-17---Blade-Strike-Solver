def isa_density(pressure_alt_ft, oat_c):
    """Air density from pressure altitude and outside air temperature.

    ISA troposphere pressure p = p0 (1 - 2.25577e-5 h)^5.25588 with h the
    pressure altitude in metres (ICAO Doc 7488), then the ideal-gas law
    rho = p / (R T) at the actual temperature.  Dry air, as JCAT gives no
    humidity: at 22 deg C, saturated air would be 1.26% less dense (50%
    relative humidity, 0.63%).
    """
    h = pressure_alt_ft * FT
    p = 101325.0 * (1.0 - 2.25577e-5 * h) ** 5.25588
    return p / (R_AIR * (oat_c + 273.15))


def mgrs(e, n, zone=42):
    """MGRS grid reference to 1 m (10 digits) for a UTM easting and northing.

    Northern hemisphere.  The 100 km square letters follow the standard MGRS
    lettering: column letters run A-H, J-R or S-Z depending on the zone (zone
    42 uses S-Z), row letters cycle A-V without I or O, shifted by five in even
    zones.  The latitude band letter is estimated from the northing, which is
    exact away from band edges (everything here is near 34 deg N, mid-band S).
    The easting and northing are truncated, never rounded, as the MGRS
    convention requires: the reference names the 1 m square that contains
    the point and denotes that square's south-west corner.
    Check: the defaults reproduce JCAT slide 15's references.
    """
    e, n = int(math.floor(e + 1e-6)), int(math.floor(n + 1e-6))   # truncate; 1e-6 m absorbs floating-point error
    col = "ABCDEFGHJKLMNPQRSTUVWXYZ"
    row = "ABCDEFGHJKLMNPQRSTUV"
    c = col[((zone - 1) % 3) * 8 + e // 100000 - 1]
    r = row[(n // 100000 + (5 if zone % 2 == 0 else 0)) % 20]
    band = "CDEFGHJKLMNPQRSTUVWX"[int((n / 110900.0 + 80.0) // 8)]
    return f"{zone}{band} {c}{r} {e % 100000:05d} {n % 100000:05d}"


def location_lines(a):
    """The helicopter and firing point lines for the top of the report, as (helicopter, firing point)."""
    helo_src = ("JCAT slide 15: probable location at hit" if a.helo_is_jcat
                else "as entered (not JCAT's reference)")
    gun_src = ("JCAT slide 15: point of origin" if a.gun_is_jcat
               else "as entered (not JCAT's reference)")
    gun_kind = {2030.0: " (turret)", 2022.0: " (ground)"}.get(a.gun_alt, "")
    return ([f"Helicopter    MGRS {mgrs(a.helo_e, a.helo_n)}, {a.helo_alt:.0f} m AMSL (wheel level)",
             f"              {helo_src}"],
            [f"Firing point  MGRS {mgrs(a.gun_e, a.gun_n)}, {a.gun_alt:.0f} m AMSL{gun_kind}",
