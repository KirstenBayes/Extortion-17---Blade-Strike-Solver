# ----------------------------------------------------------------------------
# 6. Monte Carlo: how do the tolerances combine?
# ----------------------------------------------------------------------------
def monte_carlo(a):
    """Sample every uncertain input at once and report the joint spread.

    Uniform ranges throughout (the inputs carry tolerances, not
    distributions), so intervals are "at least this wide", not formal
    confidence intervals.  The Monte Carlo always uses the drag model, with Cd
    uniform over [cd-min, cd-max].  Every sample goes through find_roots, the
    same azimuth scan as a single solve (no starting guess), and keeps its
    highest-pitch solution.
    """
    rng = np.random.default_rng(a.seed)
    n = a.mc
    U = lambda lo, hi: rng.uniform(lo, hi, n)
    P, S = a.planform_angle, a.section_angle
    planform = U(P - a.angle_tol, P + a.angle_tol)                # draw order kept from v3
    section = U(S - a.angle_tol, S + a.angle_tol)
    gun_alt = U(a.gun_alt - a.gun_alt_tol, a.gun_alt + a.gun_alt_tol)
    helo_alt = U(a.helo_alt - a.helo_alt_tol, a.helo_alt + a.helo_alt_tol)
    v0 = U(a.v0 - a.v0_tol, a.v0 + a.v0_tol)
    cd = U(a.cd_min, a.cd_max)
    pitch_att = U(-a.attitude_tol, a.attitude_tol); roll = U(-a.attitude_tol, a.attitude_tol)
    airspeed = U(a.speed_kt - a.airspeed_tol_kt, a.speed_kt + a.airspeed_tol_kt)
    wind_kt = np.clip(U(a.wind_kt - a.wind_tol_kt, a.wind_kt + a.wind_tol_kt), 0.0, None)

    cfgs = [build_cfg(a, gun_alt=gun_alt[i], helo_alt=helo_alt[i], pitch_att=pitch_att[i], roll=roll[i],
                      cd=cd[i], airspeed_kt=airspeed[i], wind_kt=wind_kt[i], v0=v0[i]) for i in range(n)]
    roots, unresolved = find_roots(cfgs, planform, section, top_only=True)
    ok = np.array([bool(r) for r in roots])
    az = np.array([r[0][0] if r else np.nan for r in roots])
    pi = np.array([r[0][1] if r else np.nan for r in roots])

    print(f"\nMONTE CARLO: {n} samples, {(~ok).sum()} with no solution ({100 * (~ok).mean():.1f}%)")
    print(f"  inputs varied (uniform): JCAT angles +/-{a.angle_tol:g} deg (author's tolerance), firing point alt +/-{a.gun_alt_tol:.0f} m,"
          f" helo alt +/-{a.helo_alt_tol:.0f} m,")
    print(f"  launch speed +/-{a.v0_tol:.0f} m/s, Cd {a.cd_min:.2f}-{a.cd_max:.2f} (drag always on), air density {a.air_density:.3f},"
          f" airspeed +/-{a.airspeed_tol_kt:.0f} kt, wind {max(a.wind_kt - a.wind_tol_kt, 0):.1f}-{a.wind_kt + a.wind_tol_kt:.1f} kt"
          f" from {a.wind_from_deg:.0f}, disc attitude +/-{a.attitude_tol:.0f} deg")
    print("  every sample solved by the blade-bearing scan (no starting guess), highest-pitch solution kept"
          + (f"; {unresolved} candidate(s) near a fold could not be confirmed" if unresolved else ""))
    if not ok.any():
        print("  no sample has a solution")
        return az, pi, ok
    # Azimuth is circular: unwrap around the circular mean so percentiles do not break at 0/360.
    # Circular mean = atan2(mean of sines, mean of cosines): average the unit vectors, take their direction.
    ref = math.degrees(math.atan2(np.sin(np.radians(az[ok])).mean(), np.cos(np.radians(az[ok])).mean()))
    az_u = ref + _wrap(az - ref)
    if (az_u[ok] < 0).any() or (az_u[ok] >= 360).any():
        print("  (bearings unwrapped around their circular mean; values below 0 or above 360 are read modulo 360)")
    for name, x in (("bearing (deg stbd of nose)", az_u[ok]), ("pitch (deg LE up)", pi[ok])):
        # Empirical percentiles: sort the samples; the p-th percentile is the value p% of the way up the
        # sorted list (numpy interpolates linearly between neighbours).  No distribution is assumed:
        # the outputs are not Gaussian, so these are not mean +/- k sigma intervals.
        q = np.percentile(x, [2.5, 5, 25, 50, 75, 95, 97.5])
        print(f"  {name:28s} median {q[3]:6.1f} | 50% {q[2]:6.1f}..{q[4]:6.1f} | 90% {q[1]:6.1f}..{q[5]:6.1f} | 95% {q[0]:6.1f}..{q[6]:6.1f}")
    # Pearson correlation coefficient, covariance / (sd_az sd_pitch) (Riley, Hobson & Bence, 3rd ed., ch. 30, p. 1200)
    print(f"  bearing-pitch correlation: {np.corrcoef(az_u[ok], pi[ok])[0, 1]:+.2f}")
    print("  (draws with no solution describe a strike no blade orientation could produce; they count against the"
          " input ranges, and they censor the high-bearing side, so the median can sit below the nominal solution)")
    return az, pi, ok


